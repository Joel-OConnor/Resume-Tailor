# Copy to .env and fill in. .env is gitignored and never leaves your machine.
#
#   cp .env.example .env

# Required for the standalone path (resume-tailor agent ... and the HTTP API).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
# RESUME_TAILOR_MODEL=claude-opus-5
# RESUME_TAILOR_MAX_TOKENS=32000
# RESUME_TAILOR_PROFILE=profile/master-profile.yaml
