# Resume-Tailor settings. Copy this file to .env and fill it in:
#
#   cp .env.example .env
#
# .env is gitignored and never committed. A real environment variable of the same name wins over
# the value here.

# --- Who answers the scripts ---------------------------------------------------------------------
#   anthropic     the Anthropic API: needs ANTHROPIC_API_KEY, billed per token
#   claude-code   a Claude Code session answers instead: each request is written to
#                 RESUME_TAILOR_RELAY_DIR and the script waits for the reply. No key, no API bill.
RESUME_TAILOR_LLM=anthropic

# --- The Anthropic API (RESUME_TAILOR_LLM=anthropic) ---------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# The model. Price per million tokens, input / output:
#   claude-fable-5-1   $10 / $50  the most capable; more than this pipeline needs
#   claude-opus-5-5    $4 / $20   the current Opus; thinks at medium effort by default
#   claude-opus-5      $5 / $25   the previous Opus; thinks at high effort by default
#   claude-sonnet-5-5  $2 / $10   the best value for this pipeline, whose checks catch mistakes
#   claude-sonnet-5    $2 / $10   the previous Sonnet
#   claude-haiku-4-5   $1 / $5    too light for the profile and the documents
RESUME_TAILOR_MODEL=claude-opus-5

# How hard the model thinks: low, medium, high, xhigh or max. Blank uses the model's own default
# (high on most, medium on claude-opus-5-5). Thinking is billed as output, so a lower setting is
# the quickest way to cut cost. Leave it blank with claude-haiku-4-5, which takes no effort setting.
RESUME_TAILOR_EFFORT=

# The longest single reply, in tokens. A full master profile runs past 15,000.
RESUME_TAILOR_MAX_TOKENS=32000

# --- The Claude Code relay (RESUME_TAILOR_LLM=claude-code) ----------------------------------------
# Where requests and replies are exchanged. Every request carries your profile, and only the
# default, .relay, is gitignored: put any other folder outside the repository (~ is your home).
RESUME_TAILOR_RELAY_DIR=.relay

# How long a script waits for each reply, in minutes, before giving up.
RESUME_TAILOR_RELAY_TIMEOUT=60
