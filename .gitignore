# --- YOUR PERSONAL DATA — never committed ---------------------------------------------------------
# Deny-by-default: everything under profile/ is the user's real career data. Only the two
# guides that ship with the project are tracked. Listing files to ignore one by one meant any
# new document added here — an outline, a technologies list — was tracked silently.
/profile/*
!/profile/HOW-TO-BUILD-YOUR-PROFILE.md
!/profile/raw/
/profile/raw/*
!/profile/raw/README.md

# Job postings you drop in to tailor against — yours, and often under an NDA
/jobs/*
!/jobs/README.md

# Applications are your data too; only the README and the demo example are tracked
/applications/*
!/applications/README.md
!/applications/example-acme-backend/

# --- generated documents (regenerate with `make export`) -------------------------------------------
*.docx
*.pdf
*.html

# --- Python ---------------------------------------------------------------------------------------
.venv*/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- tooling caches and reports -------------------------------------------------------------------
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- OS -------------------------------------------------------------------------------------------
.DS_Store

# Secrets — never committed
.env
