# --- YOUR PERSONAL DATA: never committed ----------------------------------------------------------
# Deny-by-default. Everything in my-documents/ and output/ is the user's real career data, the jobs
# they are looking at, and what was written for them; only the READMEs that explain each folder are
# tracked. Listing files to ignore one by one meant any new document added here was tracked silently.
/my-documents/*
!/my-documents/README.md
!/my-documents/career-history/
/my-documents/career-history/*
!/my-documents/career-history/README.md
!/my-documents/job-postings/
/my-documents/job-postings/*
!/my-documents/job-postings/README.md

/output/*
!/output/README.md

# The Claude Code relay (RESUME_TAILOR_LLM=claude-code): every request carries your profile
/.relay/

# --- rendered documents (re-render a .md with `resume-tailor build`) ------------------------------
*.docx
*.pdf
*.html

# --- Python ---------------------------------------------------------------------------------------
.venv*/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- tooling caches and reports -------------------------------------------------------------------
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- OS -------------------------------------------------------------------------------------------
.DS_Store

# Secrets — never committed
.env
